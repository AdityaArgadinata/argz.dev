---
const iconClass =
	"size-4 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]";
---

<section id="home" class="relative max-lg:w-[87%] mx-auto max-w-3xl overflow-visible py-20 max-sm:overflow-x-clip">
	<div class="">
		<h1
			class="text-3xl md:text-4xl lg:text-5xl xl:text-[55px] leading-none font-bold text-pretty"
		>
			Pragmatic Software Engineer, Building Maintainable Apps.
		</h1>
		<p class="xl:text-lg pt-4 text-zinc-400">
			I am <strong class="font-semibold text-zinc-100">Aditya Argadinata</strong
			>, a developer who values comfortable workflows, effective solutions, and
			code that stays maintainable beyond the first release.
		</p>
		<p class="xl:text-lg pt-2 text-zinc-400">
			I enjoy software because it trains me to think pragmatically: breaking
			real problems down, reasoning clearly, and turning ideas into useful
			systems.
		</p>
		<div class="inline-flex items-center gap-2 pt-10">
			<a
				href="https://cal.com/aditya-argadinata"
				rel="noopener"
				target="_blank"
				class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-xl bg-zinc-50 px-3 text-sm font-medium whitespace-nowrap text-zinc-950 transition-all hover:bg-zinc-200 focus-visible:ring-3 focus-visible:ring-zinc-500/50 active:translate-y-px"
			>
				<svg class={iconClass} aria-hidden="true" viewBox="0 0 24 24">
					<path
						d="M8.8 20v-4.1l1.9.2a2.3 2.3 0 0 0 2.164-2.1V8.3A5.37 5.37 0 0 0 2 8.25c0 2.8.656 3.054 1 4.55a5.77 5.77 0 0 1 .029 2.758L2 20"
					></path>
					<path d="M19.8 17.8a7.5 7.5 0 0 0 .003-10.603"></path>
					<path d="M17 15a3.5 3.5 0 0 0-.025-4.975"></path>
				</svg>
				Chit Chat
				<svg
					class="size-3 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
					aria-hidden="true"
					viewBox="0 0 24 24"
				>
					<path d="M7 7h10v10"></path>
					<path d="M7 17 17 7"></path>
				</svg>
			</a>
			<a
				href="/AdityaArgadinata.pdf"
				class="inline-flex h-9 shrink-0 items-center justify-center gap-1.5 rounded-xl bg-zinc-800 px-3 text-sm font-medium whitespace-nowrap text-zinc-50 transition-all hover:bg-zinc-700 focus-visible:ring-3 focus-visible:ring-zinc-500/50 active:translate-y-px"
			>
				<svg class={iconClass} aria-hidden="true" viewBox="0 0 24 24">
					<path
						d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"
					></path>
				</svg>
				Download Resume
				<svg
					class="size-3 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]"
					aria-hidden="true"
					viewBox="0 0 24 24"
				>
					<path d="M7 7h10v10"></path>
					<path d="M7 17 17 7"></path>
				</svg>
			</a>
		</div>
	</div>
	<img
		src="/justitia.png"
		alt="Aditya Argadinata"
		class="pointer-events-none absolute top-26 -right-20 -z-10 block w-72 max-w-none scale-x-[-1] opacity-70 brightness-[0.45] sm:-right-8 sm:w-96 lg:-top-10 lg:-right-50 lg:w-auto lg:opacity-100 [mask-image:radial-gradient(ellipse_at_center,white_20%,transparent_75%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,white_20%,transparent_75%)]"
	/>
</section>
