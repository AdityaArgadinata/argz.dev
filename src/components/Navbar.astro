---
const iconClass = 'size-4 fill-none stroke-current stroke-2 [stroke-linecap:round] [stroke-linejoin:round]';
const currentPath = Astro.url.pathname;
const navItems = [
	{
		href: '/',
		label: 'Home',
		paths: ['m3 10.5 9-7.5 9 7.5', 'M5 10v10h14V10', 'M9 20v-6h6v6'],
		active: currentPath === '/',
	},
	{
		href: '/projects',
		label: 'Projects',
		paths: ['M3 7h6l2 2h10v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M3 7V5a2 2 0 0 1 2-2h4l2 4', 'M8 13h3', 'M8 17h8'],
		active: currentPath.startsWith('/projects'),
	},
	{
		href: '/blogs',
		label: 'Blogs',
		paths: ['M4 5h16v14H4z', 'M8 9h8', 'M8 13h8', 'M8 17h5'],
		active: currentPath.startsWith('/blogs'),
	},
	{
		href: '/contact',
		label: 'Get in touch',
		paths: ['M4 6h16v12H4z', 'm4 7 8 5 8-5'],
		active: currentPath.startsWith('/contact'),
	},
];
---

<div aria-hidden="true" class="pointer-events-none fixed inset-x-0 bottom-0 z-10 h-32 bg-gradient-to-t from-zinc-950 via-zinc-950/90 to-transparent"></div>

<nav class="fixed bottom-6 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 rounded-full border border-white/10 bg-black/80 p-2 backdrop-blur-md" aria-label="Section navigation">
	{
		navItems.map((item) => (
			<a href={item.href} aria-label={item.label} aria-current={item.active ? 'page' : undefined} data-section-nav class="group relative grid size-10 place-items-center rounded-full text-zinc-400 transition-all hover:scale-110 hover:bg-white/10 hover:text-zinc-50 focus-visible:bg-white/10 focus-visible:text-zinc-50 focus-visible:outline-none aria-[current=page]:bg-white/10 aria-[current=page]:text-zinc-50">
				<span class="pointer-events-none absolute bottom-full left-1/2 mb-3 -translate-x-1/2 rounded-md border border-white/10 bg-zinc-950 px-2 py-1 text-xs font-medium whitespace-nowrap text-zinc-50 opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
					{item.label}
				</span>
				<svg class={iconClass} aria-hidden="true" viewBox="0 0 24 24">
					{item.paths.map((path) => <path d={path} />)}
				</svg>
			</a>
		))
	}
</nav>

<script>
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-nav]'));
	const sectionLinks = links.filter((link) => link.hash && link.pathname === window.location.pathname);
	const sections = sectionLinks
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => Boolean(section));

	function setActive(id: string) {
		links.forEach((link) => {
			if (link.hash === `#${id}` && link.pathname === window.location.pathname) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}
		});
	}

	function updateActiveSection() {
		let activeId = sections[0]?.id;

		sections.forEach((section) => {
			if (section.getBoundingClientRect().top <= window.innerHeight * 0.45) {
				activeId = section.id;
			}
		});

		if (activeId) setActive(activeId);
	}

	if (sections.length > 0) {
		updateActiveSection();
		window.addEventListener('scroll', updateActiveSection, { passive: true });
	}
</script>
