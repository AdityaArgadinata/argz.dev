---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: 'BBO POS',
		period: '2024 - Present',
		description: 'Business management and point of sale platform used by 300+ businesses, covering POS workflows, mobile APIs, billing, payments, access control, and performance work.',
		stack: ['PHP', 'API', 'Payments', 'RBAC'],
	},
	{
		title: 'Koi Fish Show Platform',
		period: '2025',
		description: 'A scalable web application for a nationwide Koi Fish Show contest, built around registration, contest operations, and judging workflows.',
		stack: ['Web App', 'Backend', 'Database'],
	},
];

const pageTitle = 'Projects - Argz';
const pageDescription = 'Selected software projects by Aditya Argadinata, including POS systems, business workflows, and web applications.';
---

<Layout title={pageTitle} description={pageDescription}>
	<head slot="head">
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
	</head>

	<main class="mx-auto max-w-3xl px-6 py-20">
		<header class="pb-10">
			<a href="/" class="group inline-flex items-center gap-1 text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-50">
				<svg class="size-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				Back to home
			</a>
			<h1 class="pt-6 text-3xl font-bold tracking-tight md:text-4xl">Selected Projects</h1>
			<p class="text-pretty pt-3 text-zinc-400">A short list of products, workflows, and systems I've helped build.</p>
		</header>

		<div class="divide-y divide-zinc-800 border-t border-zinc-800 pb-48">
			{
				projects.map((project) => (
					<article class="grid gap-5 py-8 sm:grid-cols-[8rem_1fr]">
						<p class="text-xs tabular-nums text-zinc-500">{project.period}</p>
						<div>
							{project.image && <img src={project.image} alt="" loading="lazy" decoding="async" class="mb-5 aspect-video w-full rounded-lg border border-zinc-800 object-cover" />}
							<h2 class="text-xl font-bold tracking-tight text-pretty">{project.title}</h2>
							<p class="text-pretty pt-2 text-sm leading-relaxed text-zinc-400">{project.description}</p>
							<ul class="flex flex-wrap gap-1.5 pt-4">
								{project.stack.map((item) => (
									<li class="inline-flex items-center rounded-md border border-zinc-800 bg-zinc-900 px-2 py-0.5 text-xs font-medium text-zinc-400">{item}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</main>
</Layout>
