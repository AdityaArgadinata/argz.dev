---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formatDate = (date: Date) => {
	const weekday = new Intl.DateTimeFormat('en-US', { weekday: 'short' }).format(date);
	const day = new Intl.DateTimeFormat('en-US', { day: 'numeric' }).format(date);
	const month = new Intl.DateTimeFormat('en-US', { month: 'long' }).format(date);
	const year = new Intl.DateTimeFormat('en-US', { year: 'numeric' }).format(date);
	return `${weekday}, ${day} ${month} ${year}`;
};

const pageTitle = `${post.data.title} | Argz`;
const pageDescription = post.data.description;
const formattedDate = formatDate(post.data.pubDate);
const isoDate = post.data.pubDate.toISOString();

// Filter headings for TOC (depth 2 and 3)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Generate JSON-LD Schema
const schemaJson = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"datePublished": isoDate,
	"author": {
		"@type": "Person",
		"name": post.data.author
	}
});
---

<Layout title={pageTitle} description={pageDescription}>
	<!-- Dynamic SEO tags via Layout head slot -->
	<head slot="head">
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={Astro.url.toString()} />
		<meta property="article:published_time" content={isoDate} />
		<meta property="article:author" content={post.data.author} />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />

		<script type="application/ld+json" is:inline set:html={schemaJson} />
	</head>

	<main class="mx-auto max-w-6xl px-6 py-20">
		<div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-12">
			<!-- Main Column -->
			<div class="lg:col-span-8">
				<header class="pb-8 border-b border-zinc-800 mb-8">
					<a href="/blogs" class="group inline-flex items-center gap-1 text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-50">
						<svg class="size-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m15 18-6-6 6-6"/>
						</svg>
						Back to writings
					</a>
					<h1 class="text-3xl md:text-4xl font-bold tracking-tight pt-6 leading-tight text-pretty">{post.data.title}</h1>
					<div class="flex items-center gap-3 pt-4 text-sm text-zinc-400">
						<span>{post.data.author}</span>
						<span>&middot;</span>
						<time datetime={isoDate} class="tabular-nums">{formattedDate}</time>
					</div>
				</header>

				<article class="prose pb-48">
					<Content />
				</article>
			</div>

			<!-- Sidebar Column (TOC) -->
			{toc.length > 0 && (
				<aside class="hidden lg:block lg:col-span-4">
					<div class="sticky top-20 border border-zinc-800 bg-zinc-950 p-6 rounded-2xl">
						<h2 class="text-xs font-semibold tracking-wide uppercase text-zinc-400">On This Page</h2>
						<nav class="toc-nav mt-4">
							<ul class="space-y-3 text-sm">
								{toc.map((heading) => (
									<li class:list={[heading.depth === 3 ? 'pl-4' : '']}>
										<a 
											href={`#${heading.slug}`} 
											class="text-zinc-400 hover:text-zinc-50 transition-all block py-0.5 border-l-2 border-transparent hover:border-zinc-700 pl-3 -ml-3"
										>
											{heading.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</div>
				</aside>
			)}
		</div>
	</main>
</Layout>

<!-- Client-side script for ScrollSpy Table of Contents active highlight -->
<script>
	const headings = Array.from(document.querySelectorAll('article h2, article h3'));
	const tocLinks = Array.from(document.querySelectorAll('nav.toc-nav a'));

	if (headings.length > 0 && tocLinks.length > 0) {
		const handleScroll = () => {
			let activeIndex = 0;
			const scrollHeight = document.documentElement.scrollHeight;
			const clientHeight = window.innerHeight;
			const scrollY = window.scrollY;
			const isBottom = clientHeight + scrollY >= scrollHeight - 60;

			if (isBottom) {
				// Find the last heading that is visible in the viewport
				for (let i = headings.length - 1; i >= 0; i--) {
					const rect = headings[i].getBoundingClientRect();
					if (rect.top >= 0 && rect.top <= clientHeight - 50) {
						activeIndex = i;
						break;
					}
				}
			} else {
				// Find the heading that has scrolled past the top threshold (200px)
				for (let i = 0; i < headings.length; i++) {
					const rect = headings[i].getBoundingClientRect();
					if (rect.top <= 200) {
						activeIndex = i;
					}
				}
			}

			console.log({
				scrollY,
				clientHeight,
				scrollHeight,
				isBottom,
				activeIndex,
				activeHeading: headings[activeIndex]?.textContent?.trim(),
				headingsTop: headings.map(h => ({
					text: h.textContent?.trim().substring(0, 20),
					top: h.getBoundingClientRect().top
				}))
			});

			// Update active link by index to bypass any ID slug mismatch issues
			tocLinks.forEach((link, idx) => {
				if (idx === activeIndex) {
					link.classList.add('text-emerald-400', 'border-emerald-500', 'font-medium');
					link.classList.remove('text-zinc-400', 'border-transparent');
				} else {
					link.classList.remove('text-emerald-400', 'border-emerald-500', 'font-medium');
					link.classList.add('text-zinc-400', 'border-transparent');
				}
			});
		};

		window.addEventListener('scroll', handleScroll, { passive: true });
		// Run initial check
		handleScroll();
	}
</script>

<style>
	/* Custom Markdown Styling for clean and premium typography */
	.prose :global(h2) {
		font-size: 1.5rem;
		font-weight: 700;
		color: #f4f4f5; /* zinc-100 */
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1.375;
		letter-spacing: -0.025em;
		scroll-margin-top: 6rem; /* scroll-mt-24 */
	}
	.prose :global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		color: #e4e4e7; /* zinc-200 */
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		line-height: 1.4;
		letter-spacing: -0.02em;
		scroll-margin-top: 6rem;
	}
	.prose :global(p) {
		font-size: 0.9375rem; /* text-[15px] */
		line-height: 1.7;
		color: #a1a1aa; /* zinc-400 */
		margin-bottom: 1.25rem;
		text-align: justify;
		text-justify: inter-word;
	}
	.prose :global(ul) {
		list-style-type: disc;
		list-style-position: inside;
		margin-bottom: 1.5rem;
		color: #a1a1aa;
		padding-left: 0.5rem;
	}
	.prose :global(li) {
		font-size: 0.9375rem;
		line-height: 1.7;
		margin-bottom: 0.5rem;
	}
	.prose :global(pre) {
		padding: 1.25rem;
		border-radius: 0.75rem;
		background-color: #18181b; /* zinc-900 */
		border: 1px solid #27272a; /* zinc-800 */
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.7;
	}
	.prose :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
		font-size: 0.85em;
		color: #f4f4f5;
		background-color: #18181b;
		border: 1px solid #27272a;
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
	}
	.prose :global(pre code) {
		background-color: transparent;
		border: none;
		padding: 0;
		border-radius: 0;
		font-size: inherit;
		color: inherit;
	}
	.prose :global(blockquote) {
		padding-left: 1.25rem;
		border-left: 4px solid #10b981; /* emerald-500 */
		font-style: italic;
		color: #d4d4d8; /* zinc-300 */
		margin-top: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.prose :global(hr) {
		border: 0;
		border-top: 1px solid #27272a;
		margin-top: 2.5rem;
		margin-bottom: 2.5rem;
	}
	.prose :global(a) {
		color: #f4f4f5;
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.2s ease;
	}
	.prose :global(a:hover) {
		color: #a1a1aa;
	}
</style>
