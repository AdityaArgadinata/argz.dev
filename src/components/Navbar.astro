		<svg class={iconClass} aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v18" /><path d="M3 12h18" /><path d="M5 5l14 14" /><path d="M19 5 5 19" /></svg>
	</a>
	<a href="#blogs" aria-label="Blogs" class="grid size-10 place-items-center rounded-full text-zinc-400 transition-all hover:scale-110 hover:bg-white/10 hover:text-zinc-50 focus-visible:bg-white/10 focus-visible:text-zinc-50 focus-visible:outline-none">
		<svg class={iconClass} aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h14v16H5z" /><path d="M8 8h8" /><path d="M8 12h8" /><path d="M8 16h5" /></svg>
	</a>
