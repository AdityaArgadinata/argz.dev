---
import Layout from '../layouts/Layout.astro';

const email = 'aditdevelop@gmail.com';
const pageTitle = 'Get in Touch - Argz';
const pageDescription = 'Send a message to Aditya Argadinata for work, collaboration, or software engineering projects.';
---

<Layout title={pageTitle} description={pageDescription}>
	<head slot="head">
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
	</head>

	<main class="mx-auto max-w-3xl px-6 py-20">
		<header class="pb-10">
			<a href="/" class="group inline-flex items-center gap-1 text-sm font-medium text-zinc-400 transition-colors hover:text-zinc-50">
				<svg class="size-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				Back to home
			</a>
			<h1 class="pt-6 text-3xl font-bold tracking-tight md:text-4xl">Get in Touch</h1>
			<p class="text-pretty pt-3 text-zinc-400">Send a message about work, collaboration, or anything worth building.</p>
		</header>

		<section class="border-t border-zinc-800 pt-8 pb-48">
			<form action={`mailto:${email}`} method="post" enctype="text/plain" class="grid gap-5">
				<label class="grid gap-2">
					<span class="text-sm font-semibold text-zinc-300">Name</span>
					<input name="name" type="text" autocomplete="name" required class="h-11 rounded-lg border border-zinc-800 bg-zinc-950 px-3 text-zinc-50 outline-none transition-colors placeholder:text-zinc-600 focus:border-zinc-500" placeholder="Your name" />
				</label>

				<label class="grid gap-2">
					<span class="text-sm font-semibold text-zinc-300">Email</span>
					<input name="email" type="email" autocomplete="email" required class="h-11 rounded-lg border border-zinc-800 bg-zinc-950 px-3 text-zinc-50 outline-none transition-colors placeholder:text-zinc-600 focus:border-zinc-500" placeholder="you@example.com" />
				</label>

				<label class="grid gap-2">
					<span class="text-sm font-semibold text-zinc-300">Message</span>
					<textarea name="message" rows="7" required class="resize-y rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-3 text-zinc-50 outline-none transition-colors placeholder:text-zinc-600 focus:border-zinc-500" placeholder="Tell me what you want to build"></textarea>
				</label>

				<div class="flex flex-wrap items-center gap-3">
					<button type="submit" class="inline-flex h-10 items-center justify-center rounded-xl bg-zinc-50 px-4 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-200 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-zinc-500/50">
						Send Message
					</button>
					<a href={`mailto:${email}`} class="text-sm font-semibold text-zinc-400 transition-colors hover:text-zinc-50">{email}</a>
				</div>
			</form>
		</section>
	</main>
</Layout>
